{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Armada",
  "version": "0.1.0",
  "identifier": "com.armada.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && bash scripts/bundle-hub.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Armada",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7380 http://*:* ws://127.0.0.1:7380 ws://*:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src http://127.0.0.1:7380 http://*:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["armada"]
      }
    }
  }
}
